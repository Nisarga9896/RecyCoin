# Copy to .env and adjust values.
PORT=5000
# Use DB_MODE=memory for local zero-config embedded MongoDB (not for deployment).
# For production/deployment: DB_MODE=uri and MONGODB_URI=<MongoDB Atlas connection string>.
DB_MODE=memory
DB_PATH=./.data/mongodb
MONGODB_URI=mongodb://127.0.0.1:27017/ewaste
JWT_SECRET=recycoin_super_secret_change_me
CLIENT_ORIGIN=http://localhost:5173